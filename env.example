# =============================================================================
# MeshMonitor Pi — Environment Configuration
# Copy this file to .env and fill in your values before running setup.sh
# DO NOT commit .env to git — it contains secrets
# =============================================================================

# -----------------------------------------------------------------------------
# Network — Pi access
# Set PI_IP to the static IP you assigned to this Pi in your router.
# ALLOWED_ORIGINS must match exactly how you access the web UI.
# For LAN-only access over HTTP, TRUST_PROXY and COOKIE_SECURE stay false.
# -----------------------------------------------------------------------------
PI_IP=YOUR_PI_IP_HERE
HOST_PORT=8080
ALLOWED_ORIGINS=http://YOUR_PI_IP_HERE:8080
TRUST_PROXY=false
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Security
# Generate a strong random SESSION_SECRET with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# -----------------------------------------------------------------------------
# Meshtastic Node — TCP source
# Set to the static IP of your Meshtastic node on the LAN.
# When using the serial-bridge sidecar instead, change this to: serial-bridge
# -----------------------------------------------------------------------------
MESHTASTIC_NODE_IP=10.45.72.250
MESHTASTIC_NODE_PORT=4403

# -----------------------------------------------------------------------------
# Timezone
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------------------------
TZ=America/Phoenix

# -----------------------------------------------------------------------------
# MQTT Proxy — upstream broker settings
# Defaults below connect to the public Meshtastic MQTT network.
# Change topic prefix to match your region/channel (e.g., msh/EU/2/e/LongFast/#)
# Leave USERNAME/PASSWORD as-is for the public broker (open access).
# -----------------------------------------------------------------------------
MQTT_BROKER=mqtt.meshtastic.org
MQTT_PORT=1883
MQTT_USERNAME=meshdev
MQTT_PASSWORD=large4cats
MQTT_TOPIC=msh/US/2/e/LongFast/#

# -----------------------------------------------------------------------------
# Watchtower — automatic image updates
# Cron format: second minute hour day month weekday
# Default: 3:00 AM daily
# -----------------------------------------------------------------------------
WATCHTOWER_SCHEDULE=0 0 3 * * *

# -----------------------------------------------------------------------------
# Serial Bridge — future use
# Uncomment and set when attaching a USB/serial Meshtastic node.
# See docker-compose.yml for full instructions.
# -----------------------------------------------------------------------------
# SERIAL_DEVICE=/dev/ttyACM0
