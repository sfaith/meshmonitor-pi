# =============================================================================
# MeshMonitor Pi — Environment Configuration
# Generated and maintained by setup.sh — do not edit manually.
# Copy this file to .env only if setting up without running setup.sh.
# DO NOT commit .env to git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Network — Pi access
# PI_IP: the IP your router always assigns to this Pi (DHCP reservation).
# ALLOWED_ORIGINS must match exactly how you access the web UI.
# For LAN-only access over HTTP, TRUST_PROXY and COOKIE_SECURE stay false.
# -----------------------------------------------------------------------------
PI_IP=YOUR_PI_IP_HERE
HOST_PORT=8080
ALLOWED_ORIGINS=http://YOUR_PI_IP_HERE:8080
TRUST_PROXY=false
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Security
# SESSION_SECRET is auto-generated by setup.sh on first run.
# Never change it after first boot — doing so invalidates all active sessions.
# -----------------------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32

# -----------------------------------------------------------------------------
# Node Connections
# Each node is numbered sequentially: NODE_1_*, NODE_2_*, NODE_3_*, etc.
# setup.sh writes these automatically. launch.sh reads them to generate the
# correct docker compose configuration.
#
# Supported types:
#   tcp    — Meshtastic node reachable on your LAN via WiFi or Ethernet
#   ble    — Meshtastic node connected via Bluetooth (BLE bridge required)
#   serial — Meshtastic node connected via USB (serial bridge required)
#
# loop-until-gap: nodes are read in order until a missing NODE_N_TYPE is found.
# Do not leave gaps (e.g. NODE_1, NODE_3 with no NODE_2).
#
# MeshMonitor connects to TCP nodes directly.
# BLE and serial nodes connect via bridge containers on the internal Docker
# network — add them as sources in Dashboard → Sources → Add Source → TCP
# using the container name as the host (e.g. meshmonitor-ble-1).
# -----------------------------------------------------------------------------

# Example TCP node (setup.sh will write real values here):
# NODE_1_TYPE=tcp
# NODE_1_NAME=My Meshtastic Node
# NODE_1_IP=YOUR_NODE_IP_HERE
# NODE_1_PORT=4403

# Example BLE node (uncomment and fill in):
# NODE_2_TYPE=ble
# NODE_2_NAME=Back Porch Node
# NODE_2_BLE_ADDRESS=AA:BB:CC:DD:EE:FF

# Example serial node (uncomment and fill in):
# NODE_3_TYPE=serial
# NODE_3_NAME=Rooftop Node
# NODE_3_SERIAL_DEVICE=/dev/ttyACM0
# NODE_3_BAUD=115200

# -----------------------------------------------------------------------------
# Timezone
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------------------------
TZ=America/Phoenix

# -----------------------------------------------------------------------------
# Auto-upgrade schedule
# Time of day for daily image pull (24-hour HH:MM format).
# Upgrade log is written to ~/meshmonitor-upgrade.log on the Pi.
# -----------------------------------------------------------------------------
UPGRADE_TIME=03:00

# -----------------------------------------------------------------------------
# Upgrade failure alerts (optional)
# If set, a push notification is sent via ntfy.sh when the nightly upgrade fails.
# Leave blank to disable — no account or registration required.
#
# To set up:
#   1. Pick a topic name — any unique string, e.g. "meshmonitor-myhostname-alerts"
#      (treat it like a password — anyone who knows it can send/subscribe)
#   2. Set NTFY_TOPIC below
#   3. Install the ntfy app (iOS/Android) and subscribe to your topic
#   4. Run: ./launch.sh status  to confirm "NTFY alerts: configured"
#
# ntfy.sh cloud is free and requires no account for basic use.
# Self-hosted ntfy is also supported — change the URL in launch.sh notify_failure().
# See also: README.md — Upgrade Failure Alerts
# -----------------------------------------------------------------------------
NTFY_TOPIC=
